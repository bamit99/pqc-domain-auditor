# PQC Domain Auditor environment configuration (all optional)

# Path to an OpenSSL 3.5+ binary (default: "openssl" on PATH)
# PQC_OPENSSL_BIN=C:\path\to\openssl.exe

# Probe backend: auto (Go dialer preferred) | go | openssl (default auto)
# PQC_BACKEND=auto

# Path to a prebuilt godialer binary (skips the automatic Go toolchain build)
# PQC_GO_DIALER=C:\path\to\godialer.exe

# Per-handshake timeout in seconds (default 10)
# PQC_TIMEOUT=10

# Default concurrency (default 32)
# PQC_CONCURRENCY=32

# crt.sh base URL (default https://crt.sh)
# PQC_CRTSH_BASE=https://crt.sh

# Optional custom DNS resolver IP
# PQC_DNS_RESOLVER=

# LLM narrative (optional - tool works without these)
# PQC_LLM_PROVIDER=ollama          # openai | anthropic | ollama | custom URL
# PQC_LLM_MODEL=llama3.1
# PQC_LLM_API_KEY=
# PQC_LLM_BASE_URL=http://localhost:11434
# PQC_LLM_ENDPOINT=
